    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "prisma": "^5.0.0",
    "turbo": "^2.1.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
